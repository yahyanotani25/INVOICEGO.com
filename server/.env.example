# ---------------------------------------------------------------------------
# InvoiceGO server configuration. Copy to server/.env (never commit real values).
# All variables are read at startup and validated (server/src/config.ts).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
# Public base URL used in emails (verification, password reset, admin invites)
APP_BASE_URL=https://invoicego.com
# Set to true when running behind a reverse proxy (nginx/Caddy/load balancer)
TRUST_PROXY=true
# Must be true in production (HTTPS-only cookies)
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=4
LOG_LEVEL=info
APP_VERSION=1.0.0

# --- Database (PostgreSQL 14+; 16 recommended) --------------------------------
DATABASE_URL=postgresql://invoicego:CHANGE_ME@127.0.0.1:5432/invoicego

# --- Secrets ------------------------------------------------------------------
# 32 random bytes, base64. Encrypts FBR tokens and admin TOTP secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Optional: previous key, accepted for decryption during key rotation
DATA_ENCRYPTION_KEY_PREVIOUS=
# 32 random bytes, base64. Encrypts database backups. Store a copy OFF the server.
BACKUP_ENCRYPTION_KEY=

# --- Email (verification, password reset, admin invitations) -----------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=InvoiceGO <no-reply@invoicego.com>
# Development only — refused in production
MAIL_LOG_ONLY=false

# --- FBR Digital Invoicing ------------------------------------------------------
# Only these origins may be called (SSRF protection). Paths are fixed to the spec.
FBR_ALLOWED_ORIGINS=https://gw.fbr.gov.pk
FBR_REFERENCE_BASE_URL=https://gw.fbr.gov.pk
FBR_HTTP_CONNECT_TIMEOUT_MS=10000
FBR_HTTP_RESPONSE_TIMEOUT_MS=60000
# STATL / Get_Reg_Type method (spec says GET but documents a JSON body; see docs/SOURCE_CONFLICTS.md A5)
FBR_LOOKUP_METHOD=POST
# Test-only escape hatch for the mock FBR server — NEVER set in production (refused at startup)
# FBR_ALLOW_TEST_ORIGINS=

# --- IP whitelisting information shown to businesses and admins --------------
# Comma-separated STATIC public egress IP(s) of this deployment (what FBR sees)
OUTBOUND_IPS=
HOSTING_COMPANY=
HOSTING_COUNTRY=

# --- Backups ------------------------------------------------------------------------
BACKUP_DIR=/var/lib/invoicego/backups
PG_DUMP_PATH=pg_dump

# --- Misc ---------------------------------------------------------------------------
UPLOAD_MAX_BYTES=5242880
# Set false on extra web replicas if you run a dedicated worker
JOB_WORKER_ENABLED=true
