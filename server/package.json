{
  "name": "@invoicego/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "data:import": "tsx scripts/import-reference-data.ts",
    "data:import:prod": "node dist/scripts/import-reference-data.js",
    "admin:invite": "tsx scripts/admin-invite.ts",
    "admin:invite:prod": "node dist/scripts/admin-invite.js",
    "backup": "tsx scripts/backup.ts",
    "backup:prod": "node dist/scripts/backup.js"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.0.3",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "8.2.0",
    "@node-rs/argon2": "2.0.2",
    "@prisma/client": "6.16.2",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "fastify": "5.6.1",
    "nodemailer": "7.0.5",
    "otplib": "12.0.1",
    "pdfkit": "0.17.1",
    "qrcode": "1.5.4",
    "undici": "7.16.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/nodemailer": "7.0.1",
    "@types/pdfkit": "0.17.2",
    "@types/qrcode": "1.5.5",
    "pino-pretty": "13.1.1",
    "prisma": "6.16.2",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
